# ULTRON runs locally without an external model provider.
# Optional OpenAI-compatible endpoint; leave blank for local-only mode.
ULTRON_LLM_API_KEY=
ULTRON_LLM_BASE_URL=
ULTRON_LLM_MODEL=
ULTRON_API_TOKEN=
ULTRON_DB_PATH=ultron.db
# Optional: dispatch ULTRON's recursive-evolution workflow from the API/skills.
# Fine-grained GitHub token requires Actions: write on MIROKKK0/ultron.
ULTRON_GITHUB_TOKEN=
ULTRON_GITHUB_REPOSITORY=MIROKKK0/ultron
ULTRON_EVOLUTION_WORKFLOW_REF=main
