# Chave do modelo usada pelo chat e pelo worker
OPENAI_API_KEY=sua_chave_aqui
# Opcional: provedores compatíveis com a API OpenAI
# ULTRON_LLM_API_KEY=sua_chave_aqui
# ULTRON_LLM_BASE_URL=https://api.openai.com/v1
# ULTRON_LLM_MODEL=gpt-4o-mini

# Gere um token forte e configure o mesmo valor no servidor e no app iOS
ULTRON_API_TOKEN=gere_um_token_forte
# Token opcional para servidores MCP que exigem Bearer
# ULTRON_MCP_TOKEN=seu_token_mcp
# Diretório em volume persistente
# ULTRON_DATA_DIR=/var/data/ultron
# Iniciar worker contínuo junto à API
# ULTRON_START_WORKER=1
