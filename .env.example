# Provedor substituível; o núcleo e a memória do ULTRON permanecem independentes.
ULTRON_PROVIDER=gemini

# Gemini (modelo padrão alinhado ao adaptador e aos testes)
GEMINI_API_KEY=sua_chave_gemini
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Alternativas OpenAI-compatible
# OPENAI_API_KEY=sua_chave_openai
# ULTRON_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter
# OPENROUTER_API_KEY=sua_chave_openrouter
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
